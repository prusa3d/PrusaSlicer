diff --git a/gmp-6.2.1/gmp-h.in b/gmp-6.2.1/gmp-h.in
--- a/gmp-6.2.1/gmp-h.in
+++ b/gmp-6.2.1/gmp-h.in
@@ -373,5 +373,16 @@
 #endif
 
+/* Clang cannot combine GNU extern inline definitions with dllimport.
+   Use local inline definitions, as for other compilers without that model;
+   non-inline functions and data retain their DLL import declarations. */
+#if defined (__clang__) && __GMP_LIBGMP_DLL && ! defined (__GMP_WITHIN_GMP) \
+    && ! defined (__GMP_WITHIN_CONFIGURE)
+#undef __GMP_EXTERN_INLINE
+#define __GMP_EXTERN_INLINE static __inline__
+#undef __GMP_INLINE_PROTOTYPES
+#define __GMP_INLINE_PROTOTYPES 0
+#endif
+
 /* DEC C (eg. version 5.9) supports "static __inline foo()", even in -std1
    strict ANSI mode.  Inlining is done even when not optimizing (ie. -O0
    mode, which is the default), but an unnecessary local copy of foo is
@@ -1783,5 +1793,5 @@
 #if GMP_NAIL_BITS == 0 || defined (_LONG_LONG_LIMB)
   /* limb==long and no nails, or limb==longlong, one limb is enough */
-  return (__gmp_n != 0 ? __gmp_l : 0);
+  return (__gmp_n != 0 ? (unsigned long) __gmp_l : 0);
 #else
   /* limb==long and nails, need two limbs when available */
@@ -2228,5 +2238,5 @@
     }
 
-  *__gmp_rp = (- *__gmp_up) & GMP_NUMB_MASK;
+  *__gmp_rp = ((mp_limb_t) 0 - *__gmp_up) & GMP_NUMB_MASK;
 
   if (--__gmp_n) /* Higher limbs get complemented. */
