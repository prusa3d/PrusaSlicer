GMP 6.2.1's vsnprintf probe rejects UCRT because %n is disabled by default.
Keep that real configure result and UCRT's process-wide security policy.
GMP's doprnt handles %n itself; its replacement formatter must still handle
the C99 %a/%A conversions which UCRT supports. Otherwise its size estimator
neither reserves space nor consumes the floating argument before vsprintf,
causing an undersized allocation and/or misreading subsequent arguments.

Account for the hex prefix and an upper bound on implicit significand
precision, then share the existing floating precision/exponent estimate
and argument consumption. Explicit precision and width remain accounted
for. No change to the CRT or long-double ABI is required.

The UCRT regression uses the existing printf-family test helpers (including
truncation boundaries) and checks mixed arguments, explicit/default precision,
double/long double extremes, and GMP's own %n without changing CRT policy.

--- a/gmp-6.2.1/printf/repl-vsnprintf.c
+++ b/gmp-6.2.1/printf/repl-vsnprintf.c
@@ -41,6 +41,7 @@
 #include <stdarg.h>
 #include <ctype.h>     /* for isdigit */
 #include <stddef.h>    /* for ptrdiff_t */
+#include <limits.h>    /* for CHAR_BIT */
 #include <string.h>
 #include <stdio.h>     /* for NULL */
 #include <stdlib.h>
@@ -227,6 +228,15 @@
 	    }
 	    goto next;
 
+	  case 'a':
+	  case 'A':
+	    /* Hex prefix and implicit precision: one hex digit per object
+	       bit is a conservative bound on the full significand.  The
+	       common floating estimate below adds explicit precision,
+	       punctuation and exponent space, and consumes the argument. */
+	    total_width += 2 + floating_sizeof * CHAR_BIT;
+	    /*FALLTHRU*/
+
 	  case 'E':
 	  case 'e':
 	  case 'G':
--- a/gmp-6.2.1/tests/misc/t-printf.c
+++ b/gmp-6.2.1/tests/misc/t-printf.c
@@ -27,6 +27,7 @@
 #include "config.h"	/* needed for the HAVE_, could also move gmp incls */
 
 #include <stdarg.h>
+#include <float.h>
 #include <stddef.h>    /* for ptrdiff_t */
 #include <stdio.h>
 #include <stdlib.h>
@@ -930,6 +931,65 @@
 }
 
 
+#if defined (_UCRT)
+void
+check_ucrt_hex (void)
+{
+  static const double values[] = { 0.0, -0.0, 1.0 / 3.0,
+                                  DBL_MIN, DBL_MAX, -DBL_MAX };
+  static const char *formats[] = { "%a|%s|%d", "%A|%s|%d",
+                                  "%#.0a|%s|%d", "%+.80A|%s|%d",
+                                  "%20.13a|%s|%d", "%-30.0A|%s|%d" };
+  char want[MAX_OUTPUT], got[MAX_OUTPUT];
+  int i, j, len, count, count_output;
+
+  /* UCRT rejects %n by default, but GMP implements it without the CRT. */
+  count_output = _get_printf_count_output ();
+  ASSERT_ALWAYS (count_output == 0);
+  for (i = 0; i < numberof (values); i++)
+    {
+      for (j = 0; j < numberof (formats); j++)
+        {
+          len = snprintf (want, sizeof (want), formats[j], values[i],
+                          "tail", 17);
+          ASSERT_ALWAYS (len >= 0 && len < sizeof (want));
+          check_one (want, formats[j], values[i], "tail", 17);
+        }
+      len = snprintf (want, sizeof (want), "%*.*a|%s|%d",
+                      -30, 40, values[i], "tail", 17);
+      ASSERT_ALWAYS (len >= 0 && len < sizeof (want));
+      check_one (want, "%*.*a|%s|%d", -30, 40, values[i], "tail", 17);
+      len = snprintf (want, sizeof (want), "%*.*A|%s|%d",
+                      100, -1, values[i], "tail", 17);
+      ASSERT_ALWAYS (len >= 0 && len < sizeof (want));
+      check_one (want, "%*.*A|%s|%d", 100, -1, values[i], "tail", 17);
+    }
+
+  len = snprintf (want, sizeof (want), "%La|%LA|%s|%d",
+                  LDBL_MIN, LDBL_MAX, "tail", 17);
+  ASSERT_ALWAYS (len >= 0 && len < sizeof (want));
+  check_one (want, "%La|%LA|%s|%d", LDBL_MIN, LDBL_MAX, "tail", 17);
+  len = snprintf (want, sizeof (want), "%.*La|%.*LA",
+                  80, LDBL_MIN, 80, LDBL_MAX);
+  ASSERT_ALWAYS (len >= 0 && len < sizeof (want));
+  check_one (want, "%.*La|%.*LA", 80, LDBL_MIN, 80, LDBL_MAX);
+
+  len = snprintf (want, sizeof (want), "%a|tail", DBL_MAX);
+  ASSERT_ALWAYS (len >= 0 && len < sizeof (want));
+  count = -1;
+  ASSERT_ALWAYS (gmp_snprintf (got, sizeof (got), "%a%n|%s",
+                               DBL_MAX, &count, "tail") == len);
+  ASSERT_ALWAYS (strcmp (got, want) == 0);
+  ASSERT_ALWAYS (count == strchr (want, '|') - want);
+  count = -1;
+  ASSERT_ALWAYS (gmp_snprintf (NULL, 0, "%a%n|%s",
+                               DBL_MAX, &count, "tail") == len);
+  ASSERT_ALWAYS (count == strchr (want, '|') - want);
+  ASSERT_ALWAYS (_get_printf_count_output () == count_output);
+}
+#endif
+
+
 int
 main (int argc, char *argv[])
 {
@@ -947,6 +1007,9 @@
   check_limb ();
   check_n ();
   check_misc ();
+#if defined (_UCRT)
+  check_ucrt_hex ();
+#endif
 
   ASSERT_ALWAYS (fclose (check_vfprintf_fp) == 0);
   unlink (CHECK_VFPRINTF_FILENAME);
