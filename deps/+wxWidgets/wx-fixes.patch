+    // macOS 27 (CoreUI/SwiftUI) draws the symbols inside NSAlert with the C
+    // library's numeric locale in effect. With a decimal comma (e.g. de_DE,
+    // fr_FR, as set by wxLocale) a symbol size is read as 0 and CoreUI throws
+    // NSInternalInconsistencyException ("targetSizeInPoints.width>0 &&
+    // targetSizeInPoints.height>0") from inside -[NSAlert runModal]. The
+    // exception ends the main loop and the application goes down.
+    // Use the "C" numeric locale on this thread while the alert is shown;
+    // other threads and the other locale categories are left alone.
+    class wxCNumericLocaleForAlert
+    {
+    public:
+        wxCNumericLocaleForAlert()
+            : m_new(newlocale(LC_NUMERIC_MASK, "C", duplocale(LC_GLOBAL_LOCALE)))
+            , m_old(m_new ? uselocale(m_new) : (locale_t)0)
+        {
+        }
+        ~wxCNumericLocaleForAlert()
+        {
+            if ( m_new )
+            {
+                uselocale(m_old);
+                freelocale(m_new);
+            }
+        }
+    private:
+        locale_t m_new;
+        locale_t m_old;
+    };
