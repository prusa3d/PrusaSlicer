# Included by CMakeLists, edited by the build script
# (the version numbers are generated by the build script from the git current label)

set(SLIC3R_APP_NAME "PrusaSlicer")
set(SLIC3R_APP_KEY "PrusaSlicer")
set(SLIC3R_VERSION_SHORT "3.0.0")
set(SLIC3R_VERSION_SUFFIX "-alpha11")
set(SLIC3R_VERSION "${SLIC3R_VERSION_SHORT}${SLIC3R_VERSION_SUFFIX}")
set(SLIC3R_BUILD_ID "PrusaSlicer-${SLIC3R_VERSION}+UNKNOWN")
set(SLIC3R_RC_VERSION_DOTS "${SLIC3R_VERSION_SHORT}.0")
string(REPLACE "." "," SLIC3R_RC_VERSION "${SLIC3R_RC_VERSION_DOTS}")
