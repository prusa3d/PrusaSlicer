msgstr "到处都是物体"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesSLA.cpp:680
msgid "Force pad around object everywhere"
msgstr "物体周围的力垫无处不在"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesSLA.cpp:686
msgid "Pad object gap"
msgstr "垫对象间隙"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesSLA.cpp:690
