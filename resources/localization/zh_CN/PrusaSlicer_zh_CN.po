#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2648
msgid "Maximum acceleration of the Z axis"
msgstr "Z 轴的最大加速度"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2649
msgid "Maximum acceleration of the E axis"
msgstr "E 轴的最大加速度"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2659
msgid "Maximum jerk X"
msgstr "最大抖动 X"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2660
