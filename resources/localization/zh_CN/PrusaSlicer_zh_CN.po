msgid "°C"
msgstr "°C"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:180
#: src/slic3r-shared/src/Slic3r/App/Config/ToolToFeatureDialog.cpp:40
msgid "Bed temperature"
msgstr "热床温度"

#. TRN: Label of a configuration parameter: Nominal chamber temperature.
#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:189
msgid "Chamber nominal temperature"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:194
msgid "Chamber temperature"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:195
msgid ""
"Required chamber temperature for the print.\n"
"When set to zero, the nominal chamber temperature is not set in the G-code."
msgstr ""

#. TRN: Label of a configuration parameter: Minimal chamber temperature
#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:206
#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:211
msgid "Chamber minimal temperature"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:212
msgid ""
"Minimal chamber temperature that the printer waits for before the print "
"starts. This allows to start the print before the nominal chamber "
"temperature is reached.\n"
"When set to zero, the minimal chamber temperature is not set in the G-code."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:223
msgid "Bed temperature by extruder"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:228
msgid ""
"The extruder which determines bed temperatures. Set to 0 to determine "
"temperatures based on the first printing extruder of the first and the "
"second layers."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:241
msgid ""
"This custom code is inserted at every layer change, right before the Z move. "
"Note that you can use placeholder variables for all PrusaSlicer settings as "
"well as [layer_num] and [layer_z]."
msgstr ""
"此自定义代码在 Z 移动之前，每次图层更改时都会插入。请注意，您可以将占位符变量"
"用于所有 PrusaSlicer 设置以及 [layer_num] 和 [layer_z]。"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:251
msgid "Between objects G-code"
msgstr "对象之间的 G-Code"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:256
msgid ""
"This code is inserted between objects when using sequential printing. By "
"default extruder and bed temperature are reset using non-wait command; "
"however if M104, M109, M140 or M190 are detected in this custom code, "
"PrusaSlicer will not add temperature commands. Note that you can use "
"placeholder variables for all PrusaSlicer settings, so you can put a \"M109 "
"S[first_layer_temperature]\" command wherever you want."
msgstr ""
"使用顺序打印时, 此代码将插入对象之间。默认情况下, 使用非等待命令重置挤出机和"
"床温;但是, 如果在此自定义代码中检测到 m104、m109、m140 或 m190,PrusaSlicer 将"
"不会添加温度命令。请注意, 您可以对所有 PrusaSlicer 设置使用占位符变量, 因此您"
"可以将  \"M109S[first_layer_temperature]\" 命令放在任何需要的地方。"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:265
msgid "Bottom solid layers"
msgstr "底部实心层"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:271
msgid "Number of solid layers to generate on bottom surfaces."
msgstr "要在底部曲面上生成的实心图层数。"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:283
msgid ""
"The number of bottom solid layers is increased above bottom_solid_layers if "
"necessary to satisfy minimum thickness of bottom shell."
msgstr ""
"如果有必要满足底部壳体的最小厚度，底部实体层的数量将增加到底部实体层之上。"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:285
msgid "Minimum bottom shell thickness"
msgstr "最小底壳厚度"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:293
msgid "Bridge"
msgstr "网桥"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:298
msgid ""
"This is the acceleration your printer will use for bridges. Set zero to "
"disable acceleration control for bridges."
msgstr "这是打印机用于搭桥的加速。设置为零以禁用搭桥的加速度控制。"

