"the following format: \"XxY/EXT, XxY/EXT, ...\"\n"
"Currently supported extensions are PNG, QOI and JPG."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigCommon.cpp:125
msgid "Format of G-code thumbnails"
msgstr "G-Code 缩略图格式"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigCommon.cpp:128
msgid ""
"Format of G-code thumbnails: PNG for best quality, JPG for smallest size, "
"QOI for low memory firmware"
msgstr "G-Code 缩略图格式: PNG 质量最佳，JPG 尺寸最小，QOI 用于低内存固件"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigCommon.cpp:140
