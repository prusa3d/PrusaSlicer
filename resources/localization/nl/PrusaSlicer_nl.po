msgstr "Hoe limieten toe te voegen"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2582
msgid "Purpose of machine limits"
msgstr "Doel van de machinelimieten"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2586
msgid "How to apply the machine limits"
msgstr "Hoe machinelimieten toe te voegen"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2589
msgid "Emit to G-code"
msgstr "Invoegen in de G-code"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2591
msgid "Use for time estimate"
msgstr "Gebruik om tijd te schatten"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2592
msgid "Ignore"
msgstr "Negeren"

