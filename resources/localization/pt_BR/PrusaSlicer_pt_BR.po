msgstr "Aceleração máxima do eixo Z"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesFDM.cpp:2448
msgid "Maximum acceleration of the E axis"
msgstr "Aceleração máxima do eixo E"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesFDM.cpp:2458
msgid "Maximum jerk X"
msgstr "Máximo empurrão X"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesFDM.cpp:2459
msgid "Maximum jerk Y"
msgstr "Máximo empurrão Y"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesFDM.cpp:2460
