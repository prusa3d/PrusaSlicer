msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2695
msgid ""
"Maximum junction deviation (M205 J, only apply if JD > 0 for Marlin "
"firmware)."
msgstr ""

