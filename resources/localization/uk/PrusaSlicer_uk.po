#. TRN Alert when support is needed. Describes that the model has long bridging extrusions which may print badly
#: src/libslic3r/src/libslic3r/Print.cpp:1887
msgid "Long bridging extrusions"
msgstr "Екструзія довгих мостів"

#. TRN Alert when support is needed. Describes bridge anchors/turns in the air, which will definitely print badly
#: src/libslic3r/src/libslic3r/Print.cpp:1889
msgid "Floating bridge anchors"
msgstr "Прив'язки плаваючого мосту"

#. TRN Alert when support is needed. Describes that the print has large overhang area which will print badly or not print at all.
#: src/libslic3r/src/libslic3r/Print.cpp:1893
msgid "Collapsing overhang"
msgstr "Падаюче нависання"

#. TRN Alert when support is needed. Describes extrusions that are not supported enough and come out curled or loose.
#: src/libslic3r/src/libslic3r/Print.cpp:1896
msgid "Loose extrusions"
msgstr "Екструзія в повітря"

#. TRN Alert when support is needed. Describes that the print has low bed adhesion and may became loose.
#: src/libslic3r/src/libslic3r/Print.cpp:1900
msgid "Low bed adhesion"
msgstr "Слабка адгезія до столу"

#. TRN Alert when support is needed. Describes that the object has part that is not connected to the bed and will not print at all without supports.
#: src/libslic3r/src/libslic3r/Print.cpp:1902
msgid "Floating object part"
msgstr "Частина деталі в повітрі"

#. TRN Alert when support is needed. Describes that the object has thin part that may brake during printing
#: src/libslic3r/src/libslic3r/Print.cpp:1904
msgid "Thin fragile part"
msgstr "Тонка крихка частина"

