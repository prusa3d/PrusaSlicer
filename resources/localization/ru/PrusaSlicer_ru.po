msgstr "Максимальный рывок у экструдера (E)"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2667
msgid "Maximum jerk of the X axis"
msgstr "Максимальный рывок по оси X."

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2668
