#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesSLA.cpp:232
#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesSLA.cpp:236
msgid "Printer absolute correction"
msgstr "Correcció absoluta de la impressora"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesSLA.cpp:237
msgid ""
"Will inflate or deflate the sliced 2D polygons according to the sign of the "
"correction."
msgstr ""
"Augmentarà o reduirà el nombre de polígons 2D laminats d'acord amb el signe "
"de la correcció."

#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesSLA.cpp:244
msgid "Elephant foot minimum width"
msgstr "Amplada mínima del peu d'elefant"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesSLA.cpp:248
msgid ""
"Minimum width of features to maintain when doing elephant foot compensation."
msgstr ""
"Amplada mínima de les característiques a mantenir quan es fa una compensació "
"del peu d'elefant."

#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesSLA.cpp:255
msgid "Z compensation"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesSLA.cpp:259
