msgstr "Şişe ağırlığı"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesSLA.cpp:332
msgid "kg"
msgstr "kg"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesSLA.cpp:343
msgid "g/ml"
msgstr "g/ml"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesSLA.cpp:354
msgid "money/bottle"
msgstr "para/şişe"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesSLA.cpp:361
