msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2084
msgid "Find / replace patterns in G-code lines and substitute them."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2090
msgid "High extruder current on filament swap"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2094
msgid ""
"It may be beneficial to increase the extruder motor current during the "
"filament exchange sequence to allow for rapid ramming feed rates and to "
"overcome resistance when loading a filament with an ugly shaped tip."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2101
msgid "Enable pressure advance during ramming"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2105
msgid "Check to enable pressure advance during ramming."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2115
msgid ""
"This is the acceleration your printer will use for infill. Set zero to "
"disable acceleration control for infill."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2124
#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:3746
#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:3763
#: src/slic3r-shared/src/Slic3r/App/Config/ToolToFeatureDialog.cpp:32
#: src/slic3r-shared/src/Slic3r/App/Preview/Types.cpp:45
msgid "Solid infill"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2129
msgid ""
"This is the acceleration your printer will use for solid infill. Set zero to "
"use the value for infill."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2138
#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:4596
#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:4614
#: src/slic3r-shared/src/Slic3r/App/Preview/Types.cpp:46
msgid "Top solid infill"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2143
msgid ""
"This is the acceleration your printer will use for top solid infill. Set "
"zero to use the value for solid infill."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2157
msgid ""
"This is the acceleration your printer will use for wipe tower. Set zero to "
"disable acceleration control for the wipe tower."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2167
#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:4662
#: src/slic3r-shared/src/Slic3r/App/Preview/Types.cpp:26
msgid "Travel"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2172
msgid ""
"This is the acceleration your printer will use for travel moves. Set zero to "
"disable acceleration control for travel."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2182
msgid "Travel short distance acceleration"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2188
msgid ""
"Acceleration used for short travel moves. Short travel distance is "
"determined by the retract_before_travel setting."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2197
msgid "Combine infill every"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2202
msgid ""
"This feature allows to combine infill and speed up your print by extruding "
"thicker infill layers while preserving thin perimeters, thus accuracy."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2205
msgid "Combine infill every n layers"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2212
msgid "Length of the infill anchor"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2217
msgid ""
"Connect an infill line to an internal perimeter with a short segment of an "
"additional perimeter. If expressed as percentage (example: 15%) it is "
"calculated over infill extrusion width. PrusaSlicer tries to connect two "
"close infill lines to a short perimeter segment. If no such perimeter "
"segment shorter than infill_anchor_max is found, the infill line is "
"connected to a perimeter segment at just one side and the length of the "
"perimeter segment taken is limited to this parameter, but no longer than "
"anchor_length_max. Set this parameter to zero to disable anchoring "
"perimeters connected to a single infill line."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2226
msgid "0 (no open anchors)"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2227
#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2255
msgid "1 mm"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2228
#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2256
msgid "2 mm"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2229
#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2257
msgid "5 mm"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2230
#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2258
msgid "10 mm"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2231
#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2259
msgid "1000 (unlimited)"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2240
msgid "Maximum length of the infill anchor"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2245
msgid ""
"Connect an infill line to an internal perimeter with a short segment of an "
"additional perimeter. If expressed as percentage (example: 15%) it is "
"calculated over infill extrusion width. PrusaSlicer tries to connect two "
"close infill lines to a short perimeter segment. If no such perimeter "
"segment shorter than this parameter is found, the infill line is connected "
"to a perimeter segment at just one side and the length of the perimeter "
"segment taken is limited to infill_anchor, but no longer than this "
"parameter. Set this parameter to zero to disable anchoring."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2254
msgid "0 (not anchored)"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2267
msgid "Infill extruder"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2272
msgid "The extruder to use when printing infill."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2284
msgid ""
"Set this to a non-zero value to set a manual extrusion width for infill. If "
"left zero, default extrusion width will be used if set, otherwise 1.125 x "
"nozzle diameter will be used. You may want to use fatter extrudates to speed "
"up the infill and make your parts stronger. If expressed as percentage (for "
"example 90%) it will be computed over nozzle diameter."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2297
msgid "Infill before perimeters"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2302
msgid ""
"This option will switch the print order of perimeters and infill, making the "
"latter first."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2308
msgid "Infill/perimeters overlap"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2312
msgid ""
"This setting applies an additional overlap between infill and perimeters for "
"better bonding. Theoretically this shouldn't be needed, but backlash might "
"cause gaps. If expressed as percentage (example: 15%) it is calculated over "
"perimeter extrusion width."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2327
msgid "Speed for printing the internal fill. Set to zero for auto."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2351
msgid "Interface shells"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2356
msgid ""
"Force the generation of solid shells between adjacent materials/volumes. "
"Useful for multi-extruder prints with translucent materials or manual "
"soluble support material."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2364
msgid "Maximum width of a segmented region"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2368
msgid "Maximum width of a segmented region. Zero disables this feature."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2377
msgid "Interlocking depth of a segmented region"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2381
msgid ""
"Interlocking depth of a segmented region. It will be ignored if "
"\"mmu_segmented_region_max_width\" is zero or if "
"\"mmu_segmented_region_interlocking_depth\"is bigger then "
"\"mmu_segmented_region_max_width\". Zero disables this feature."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2392
msgid "Enable ironing"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2397
msgid ""
"Enable ironing of the top layers with the hot print head for smooth surface"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2403
msgid "Use beam interlocking"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2407
msgid ""
"Generate interlocking beam structure at the locations where different "
"filaments touch. This improves the adhesion between filaments, especially "
"models printed in different materials."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2414
msgid "Interlocking beam width"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2418
msgid "The width of the interlocking structure beams."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2427
msgid "Interlocking direction"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2431
msgid "Orientation of interlocking beams."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2441
msgid "Interlocking beam layers"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2446
msgid ""
"The height of the beams of the interlocking structure, measured in number of "
"layers. Less layers is stronger, but more prone to defects."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2453
msgid "Interlocking depth"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2457
msgid ""
"The distance from the boundary between filaments to generate interlocking "
"structure, measured in cells. Too few cells will result in poor adhesion."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2465
msgid "Interlocking boundary avoidance"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2469
msgid ""
"The distance from the outside of a model where interlocking structures will "
"not be generated, measured in cells."
msgstr ""

