#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1116
#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsSLA.cpp:274
#: src/slic3r-shared/src/Slic3r/App/Preview/FdmViewerWrapper.cpp:1157
msgid "Color"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1124
msgid ""
"Leave unused if the filament profile isn't tied to a specific color. Color "
"can still be set at project-level."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1131
msgid "Filament notes"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1136
msgid "You can put your notes regarding the filament here."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1145
#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2798
msgid "Max volumetric speed"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1149
msgid ""
"Maximum volumetric speed allowed for this filament. Limits the maximum "
"volumetric speed of a print to the minimum of print and filament volumetric "
"speed. Set to zero for no limit."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1152
#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1421
#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2805
#: src/slic3r-shared/src/Slic3r/Biz/Units.cpp:46
#: src/slic3r-shared-wx/src/Slic3r/App/WX/RammingChart.cpp:141
msgid "mm³/s"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1159
msgid "Max non-crossing infill speed"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1164
msgid ""
"Maximum speed allowed for this filament while printing infill without any "
"self intersections in a single layer. Set to zero for no limit."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1174
msgid "Max crossing infill speed"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1179
msgid ""
"Maximum speed allowed for this filament while printing infill with self "
"intersections in a single layer. Set to zero for no limit."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1189
msgid "Loading speed"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1194
msgid "Speed used for loading the filament on the wipe tower."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1202
msgid "Loading speed at the start"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1207
msgid "Speed used at the very beginning of loading phase."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1215
msgid "Unloading speed"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1220
msgid ""
"Speed used for unloading the filament on the wipe tower (does not affect  "
"initial part of unloading just after ramming)."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1229
msgid "Unloading speed at the start"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1234
msgid ""
"Speed used for unloading the tip of the filament immediately after ramming."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1242
msgid "Delay after unloading"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1247
msgid ""
"Time to wait after the filament is unloaded. May help to get reliable "
"toolchanges with flexible materials that may need more time to shrink to "
"original dimensions."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1257
msgid "Stamping loading speed"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1262
msgid "Speed used for stamping."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1270
msgid "Stamping distance measured from the center of the cooling tube"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1275
msgid ""
"If set to nonzero value, filament is moved toward the nozzle between the "
"individual cooling moves (\"stamping\"). This option configures how long "
"this movement should be before the filament is retracted again."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1284
msgid "Number of cooling moves"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1289
msgid ""
"Filament is cooled by being moved back and forth in the cooling tubes. "
"Specify desired number of these moves."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1298
msgid "Speed of the first cooling move"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1303
msgid "Cooling moves are gradually accelerating beginning at this speed."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1311
msgid "Minimal purge on wipe tower"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1316
msgid ""
"After a tool change, the exact position of the newly loaded filament inside "
"the nozzle may not be known, and the filament pressure is likely not yet "
"stable. Before purging the print head into an infill or a sacrificial "
"object, PrusaSlicer will always prime this amount of material into the wipe "
"tower to produce successive infill or sacrificial object extrusions reliably."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1320
#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1408
#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1436
#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:2983
#: src/slic3r-shared/src/Slic3r/Biz/Units.cpp:45
msgid "mm³"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1327
msgid "Speed of the last cooling move"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1332
msgid "Cooling moves are gradually accelerating towards this speed."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1340
msgid "Purge volume multiplier"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1345
msgid ""
"Purging volume on the wipe tower is determined by 'multimaterial_purging' in "
"Printer settings. This option allows to modify the volume on filament level. "
"Note that the project can override this by setting project-specific values."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1355
msgid "Ramming parameters"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1360
msgid ""
"This string is edited by RammingDialog and contains ramming specific "
"parameters."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1367
msgid "Ramming temperature variation"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1371
msgid ""
"Temperature difference to be applied right before ramming. The value can be "
"negative."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1378
msgid "Pause before ramming"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1383
msgid ""
"Time in seconds that the printer will remain idle before ramming, allowing "
"the melt zone temperature to equalize."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1389
msgid "Enable ramming for multitool setups"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1394
msgid ""
"Perform ramming when using multitool printer (i.e. when the 'Single extruder "
"multimaterial' in Printer settings is unchecked). When checked, a small "
"amount of filament is rapidly extruded on the wipe tower just before the "
"toolchange. This option is only used when the wipe tower is enabled."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1402
msgid "Multitool ramming volume"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1407
msgid "The volume to be rammed before the toolchange."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1415
msgid "Multitool ramming flow"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1420
msgid "Flow used for ramming the filament before the toolchange."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1428
msgid "Flush volume"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1434
msgid ""
"Volume of filament to flush during a tool change. Used in custom toolchange "
"G-code."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1443
msgid "Flush speed"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1449
msgid ""
"Extrusion speed used for flushing during a tool change. Used in custom "
"toolchange G-code."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1458
#: src/slic3r-shared/src/Slic3r/App/Plater/MeasureDialog.cpp:156
#: src/slic3r-shared/src/Slic3r/Biz/Config/BedShape.cpp:53
msgid "Diameter"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1463
msgid ""
"Enter your filament diameter here. Good precision is required, so use a "
"caliper and do multiple measurements along the filament, then compute the "
"average."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1472
#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsSLA.cpp:340
#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsSLA.cpp:344
#: src/slic3r-shared/src/Slic3r/App/Plater/SlaSupportPointsDialog.cpp:47
msgid "Density"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1477
msgid ""
"Enter your filament density here. This is only for statistical information. "
"A decent way is to weigh a known length of filament and compute the ratio of "
"the length to volume. Better is to calculate the volume directly through "
"displacement."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1480
msgid "g/cm³"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1487
msgid "Filament type"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1492
msgid "The filament material type for use in custom G-codes."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1520
msgid "Soluble material"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1525
msgid "Soluble material is most likely used for a soluble support."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1531
msgid "Abrasive material"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1536
msgid ""
"This flag means that the material is abrasive and requires a hardened "
"nozzle. The value is used by the printer to check it."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1541
#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsSLA.cpp:351
#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsSLA.cpp:355
#: src/slic3r-shared/src/Slic3r/App/ObjectListWindow.cpp:107
msgid "Cost"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigDefsFDM.cpp:1546
msgid ""
"Enter your filament cost per kg here. This is only for statistical "
"information."
msgstr ""

