#: src/slic3r-shared/src/Slic3r/App/Preview/FdmViewerWrapper.cpp:979
#: src/slic3r-shared/src/Slic3r/App/Preview/Types.cpp:90
#: src/slic3r-shared/src/Slic3r/App/Preview/Types.cpp:93
msgid "Height"
msgstr "Korkeus"

#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesFDM.cpp:995
msgid ""
"Only used when 'Print Settings -> Complete individual objects' is active. "
"Set this to the vertical distance between your nozzle tip and (usually) the "
"X carriage rods. Used to check for collisions with previously printed "
"objects and to prevent them when arranging.\n"
"The value is ignored for most Prusa printers, which come with more detailed "
"extruder model."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesFDM.cpp:1009
msgid "Radius"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesFDM.cpp:1010
msgid ""
"Only used when 'Print Settings -> Complete individual objects' is active. "
"Set this to a radius of a nozzle-centered cylinder big enough to enclose the "
"extruder assembly. Used to check for collisions with previously printed "
"objects and to prevent them when arranging.\n"
"The value is ignored for most Prusa printers, which come with more detailed "
"extruder model."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesFDM.cpp:1020
msgid "Extrusion multiplier"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesFDM.cpp:1025
msgid ""
"This factor changes the amount of flow proportionally. You may need to tweak "
"this setting to get nice surface finish and correct single wall widths. "
"Usual values are between 0.9 and 1.1. If you think you need to change this "
"more, check filament diameter and your firmware E steps."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesFDM.cpp:1035
msgid "Default extrusion width"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesFDM.cpp:1040
msgid ""
"Set this to a non-zero value to allow a manual extrusion width. If left to "
"zero, Slic3r derives extrusion widths from the nozzle diameter (see the "
"tooltips for perimeter extrusion width, infill extrusion width etc). If "
"expressed as percentage (for example: 230%), it will be computed over nozzle "
"diameter."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesFDM.cpp:1052
msgid "Keep fan always on"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesFDM.cpp:1057
msgid ""
"If this is enabled, fan will never be disabled and will be kept running at "
"least at its minimum speed. Useful for PLA, harmful for ABS."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesFDM.cpp:1063
msgid "Enable fan if layer print time is below"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesFDM.cpp:1068
msgid ""
"If layer print time is estimated below this number of seconds, fan will be "
"enabled and its speed will be calculated by interpolating the minimum and "
"maximum speeds."
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesFDM.cpp:1070
#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesFDM.cpp:3468
msgid "approximate seconds"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesFDM.cpp:1077
msgid "Filament change time"
msgstr ""

#: src/slic3r-domain/src/Slic3r/Domain/ConfigBoxesFDM.cpp:1081
msgid ""
"Time required for a single filament change. On a printer with multiple tools "
"this is the time required for a single toolchange to take place. On a "
"printer with multi-material upgrade, this is the time required to unload and "
"load a new filament."
msgstr ""

